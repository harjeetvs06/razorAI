# ═══════════════════════════════════════════════════════════════════════════════
# RazorAI — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── RAZORPAY (Get from https://dashboard.razorpay.com) ─────────────────────────
# For TESTING: Use these test credentials (dummy values work in dev mode)
RAZORPAY_KEY_ID=rzp_test_TVrNPnwMO5QHXQ
RAZORPAY_KEY_SECRET=Ic4KEbWvrwoRKqvge3KiPpT6
RAZORPAY_WEBHOOK_SECRET=WEBHOOK_SECRET_HERE

# For PRODUCTION: Replace with real keys from Razorpay Dashboard
# RAZORPAY_KEY_ID=rzp_live_1Aa2Bb3Cc4Dd5Ee6F
# RAZORPAY_KEY_SECRET=actual_secret_key_here
# RAZORPAY_WEBHOOK_SECRET=webhook_secret_from_dashboard

# ── APP ENVIRONMENT ──────────────────────────────────────────────────────────
# Set to "development" to use mock Razorpay calls (no real API calls)
# Set to "production" to use actual Razorpay API
APP_ENV=development

# ── ALLOWED ORIGINS (CORS) ───────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API
# For local dev: keep as-is
# For production: change to your domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── DATABASE (PostgreSQL) ────────────────────────────────────────────────────
# Only needed if you enable database persistence (currently optional)
# Leave as-is for in-memory testing
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorai

# ── OpenAI (Optional — for future LLM features) ──────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx